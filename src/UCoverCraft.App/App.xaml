<Application x:Class="UCoverCraft.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UCoverCraft.App.ViewModels"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <vm:ExportStateToVisibilityConverter x:Key="ExportStateToVisibilityConverter" />
      <vm:ExportStateToBooleanConverter x:Key="ExportStateToBooleanConverter" />
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/LightTheme.xaml" />
        <ResourceDictionary Source="Styles/AppStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
